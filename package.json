  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
